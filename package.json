{
  "name": "hidden-door-vault",
  "productName": "Hidden Door Vault",
  "version": "0.1.0",
  "private": true,
  "description": "A client-encrypted, Google Secret Manager-backed credential vault for the macOS menu bar and the Linux system tray.",
  "main": "src/main.cjs",
  "bin": {
    "hdv": "./bin/hdv.cjs"
  },
  "author": "The Hidden Door",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "build:mac": "node scripts/package-mac.cjs",
    "package:mac": "node scripts/package-mac.cjs",
    "build:linux": "node scripts/package-linux.cjs",
    "package:linux": "node scripts/package-linux.cjs",
    "install:linux": "bash scripts/install-linux.sh"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "44.7.1"
  }
}
